    <!-- Register Pentaho Reports in stretchy_report table -->
    <!-- These reports require .prpt files to be deployed at FINERACT_PENTAHO_REPORTS_PATH/pentahoReportsPostgres/ -->

    <changeSet author="fineract" id="pentaho-reports-registration-1">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM stretchy_report WHERE report_name = 'Active Loan Summary per Branch' AND report_type = 'Pentaho'
            </sqlCheck>
        </preConditions>
        <insert tableName="stretchy_report">
            <column name="report_name" value="Active Loan Summary per Branch"/>
            <column name="report_type" value="Pentaho"/>
            <column name="report_subtype"/>
            <column name="report_category" value="Loan"/>
            <column name="report_sql"/>
            <column name="description" value="Active Loan Summary per Branch"/>
            <column name="core_report" valueBoolean="false"/>
            <column name="use_report" valueBoolean="true"/>
            <column name="self_service_user_report" valueBoolean="false"/>
