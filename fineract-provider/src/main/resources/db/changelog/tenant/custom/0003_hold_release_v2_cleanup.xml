<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!--
        Hold & Release V2 Cleanup Migration

        This migration cleans up unused columns from the initial implementation
        and keeps only the required related_transaction_id column.

        Simplified schema:
        - related_transaction_id: Links withdrawal to its originating release transaction
        - Existing hold -> release linkage uses release_id_of_hold_amount (unchanged)
    -->

    <!-- Drop unused indexes first -->
    <changeSet author="fineract" id="1">
        <preConditions onFail="MARK_RAN">
            <indexExists indexName="idx_savings_txn_hold_id"/>
        </preConditions>
        <dropIndex tableName="m_savings_account_transaction" indexName="idx_savings_txn_hold_id"/>
    </changeSet>

    <changeSet author="fineract" id="2">
        <preConditions onFail="MARK_RAN">
            <indexExists indexName="idx_savings_txn_hold_release"/>
        </preConditions>
        <dropIndex tableName="m_savings_account_transaction" indexName="idx_savings_txn_hold_release"/>
    </changeSet>

    <!-- Drop unused foreign key -->
    <changeSet author="fineract" id="3">
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists foreignKeyName="fk_savings_txn_hold"/>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="m_savings_account_transaction" constraintName="fk_savings_txn_hold"/>
    </changeSet>

    <!-- Drop unused columns -->
    <changeSet author="fineract" id="4">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_savings_account_transaction" columnName="hold_transaction_id"/>
        </preConditions>
        <dropColumn tableName="m_savings_account_transaction" columnName="hold_transaction_id"/>
    </changeSet>

    <changeSet author="fineract" id="5">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_savings_account_transaction" columnName="transaction_sub_type"/>
        </preConditions>
        <dropColumn tableName="m_savings_account_transaction" columnName="transaction_sub_type"/>
    </changeSet>

    <changeSet author="fineract" id="6">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_savings_account_transaction" columnName="is_from_hold_release"/>
        </preConditions>
        <dropColumn tableName="m_savings_account_transaction" columnName="is_from_hold_release"/>
    </changeSet>

    <changeSet author="fineract" id="7">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_savings_account_transaction" columnName="remaining_hold_amount"/>
        </preConditions>
        <dropColumn tableName="m_savings_account_transaction" columnName="remaining_hold_amount"/>
    </changeSet>

    <changeSet author="fineract" id="8">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_savings_account_transaction" columnName="operation_type"/>
        </preConditions>
        <dropColumn tableName="m_savings_account_transaction" columnName="operation_type"/>
    </changeSet>

    <changeSet author="fineract" id="9">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_savings_account_transaction" columnName="originating_channel"/>
        </preConditions>
        <dropColumn tableName="m_savings_account_transaction" columnName="originating_channel"/>
    </changeSet>

</databaseChangeLog>
